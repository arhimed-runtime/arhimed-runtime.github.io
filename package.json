{
  "name": "arhimed-manim-gx-runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "fetch:locked-runtime-assets": "node scripts/fetch-locked-runtime-assets.mjs",
    "verify:locked-runtime-assets": "node scripts/verify-locked-runtime-assets.mjs",
    "verify:published-runtime-assets": "node scripts/verify-published-runtime-assets.mjs",
    "test:cross-origin": "node scripts/run-cross-origin-tests.mjs",
    "check:pages-size": "node scripts/check-pages-size.mjs",
    "test:pages": "playwright test --config=playwright.pages.config.ts",
    "test:no-webgpu": "playwright test --config=playwright.no-webgpu.config.ts"
  },
  "dependencies": {
    "manimgx": "0.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
